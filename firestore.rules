rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email.lower() == 'andrewokop@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function valid(data) {
      return data.keys().hasOnly(['models', 'purchases', 'sales', 'schemaVersion', 'generation', 'revision', 'appliedIds', 'updatedAt'])
        && data.keys().hasAll(['models', 'purchases', 'sales', 'schemaVersion', 'generation', 'revision', 'appliedIds', 'updatedAt'])
        && data.schemaVersion == 2
        && data.generation is string && data.generation.size() > 0 && data.generation.size() <= 100
        && data.revision is int && data.revision > 0
        && data.models is list && data.models.size() <= 100
        && data.purchases is list && data.sales is list
        && data.purchases.size() + data.sales.size() <= 3000
        && data.appliedIds is list && data.appliedIds.size() <= 500
        && data.updatedAt == request.time;
    }
    match /users/{userId}/workspace/main {
      allow get: if owner(userId);
      allow create: if owner(userId) && valid(request.resource.data) && request.resource.data.revision == 1;
      allow update: if owner(userId) && valid(request.resource.data)
        && (resource.data.get('schemaVersion', 0) != 2
          ? request.resource.data.revision == 1
            && request.resource.data.models.size() == 0
            && request.resource.data.purchases.size() == 0
            && request.resource.data.sales.size() == 0
          // Optimistic transactions must reach their read precondition check,
          // including when another transaction has just advanced the revision.
          : request.resource.data.revision >= resource.data.revision
            && request.resource.data.revision <= resource.data.revision + 1
            && (request.resource.data.generation != resource.data.generation
              || request.resource.data.appliedIds != resource.data.appliedIds));
      allow delete: if false;
    }
  }
}
